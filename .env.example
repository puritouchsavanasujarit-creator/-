# ── AI provider ───────────────────────────────────────────────────────────────
# The app can talk to Google Gemini or to any OpenAI-compatible API. Set
# LLM_API_KEY to use the alternative provider; leave it empty to keep Gemini.
# That choice is made the same way in server.ts (dev) and worker.ts (deploy).

# LLM_API_KEY: required to use the alternative provider (e.g. a Groq key from
# console.groq.com — free tier, no credit card).
LLM_API_KEY=""

# LLM_API_KEY_2: optional backup key, used when the first one returns 429/403.
LLM_API_KEY_2=""

# LLM_BASE_URL: OpenAI-compatible base URL. Defaults to Groq.
#   Groq       https://api.groq.com/openai/v1
#   OpenRouter https://openrouter.ai/api/v1
#   Together   https://api.together.xyz/v1
#   Cerebras   https://api.cerebras.ai/v1
#   Mistral    https://api.mistral.ai/v1
LLM_BASE_URL="https://api.groq.com/openai/v1"

# LLM_MODEL / LLM_MODEL_2: model ids for the primary and backup attempt.
LLM_MODEL="openai/gpt-oss-120b"
LLM_MODEL_2=""

# ── Google Gemini (kept for Google Search/Maps grounding) ─────────────────────
# GEMINI_API_KEY: used when LLM_API_KEY is empty. Google Search/Maps grounding
# only exists on Gemini; other providers answer without live sources, with Exa
# links when EXA_API_KEY is set.
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EXA_API_KEY: Optional API key for Exa web search (/api/tools/web-search) and the
# backup reference links used by /api/tools/search when live grounding is unavailable.
EXA_API_KEY=""
